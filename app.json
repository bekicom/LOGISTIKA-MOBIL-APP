{
  "expo": {
    "name": "FURAM",
    "slug": "furam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "furam",
    "userInterfaceStyle": "light",
    "primaryColor": "#f45a18",
    "ios": {
      "bundleIdentifier": "uz.furam.app",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "Reys davomida joylashuvingiz yuk egasi va dispetcherga ko'rsatiladi — ular yukning qayerdaligini biladi.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Telefon cho'ntagingizda bo'lganda ham reys yo'li yozilib borishi uchun. Faqat reys davomida, reys yopilishi bilan to'xtaydi."
      }
    },
    "android": {
      "package": "uz.furam.app",
      "adaptiveIcon": {
        "backgroundColor": "#f45a18",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1526",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Reys davomida joylashuvingiz yuk egasi va dispetcherga ko'rsatiladi. Faqat reys davomida, reys yopilishi bilan to'xtaydi.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#f45a18"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
